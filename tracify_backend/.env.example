# Application Settings
APP_NAME=Tracerfy API
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tracerfy_db

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
STRUCTURED_LOGGING=false

# Rate Limiting Configuration
ENABLE_RATE_LIMITING=true
ADVANCED_RATE_LIMITING=false
SLOW_REQUEST_THRESHOLD=2.0

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# Stripe Payment Configuration (Optional)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# DNC Registry APIs (Optional)
FEDERAL_DNC_API_URL=https://www.donotcall.gov/api
FEDERAL_DNC_API_KEY=your-federal-dnc-api-key
STATE_DNC_API_URL=https://api.state-dnc.com
STATE_DNC_API_KEY=your-state-dnc-api-key
DMA_API_URL=https://api.dma.org
DMA_API_KEY=your-dma-api-key
TCPA_LITIGATOR_API_URL=https://api.tcpalitigator.com
TCPA_LITIGATOR_API_KEY=your-tcpa-litigator-api-key

# Celery Configuration (Optional)
ENABLE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
